{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": ".harness/bin/harnessctl review --quiet"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".harness/bin/harnessctl score --host codex --stop-hook"
          }
        ]
      }
    ]
  }
}
