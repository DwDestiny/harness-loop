{
  "task": "Graduate harness-loop into a clean, agent-readable, stable delivery baseline",
  "type": "feature",
  "threshold": 90,
  "max_attempts": 4,
  "acceptance": [
    {
      "id": "A1",
      "text": "Historical delivery plan is archived, and no longer occupies the main docs entrypoint.",
      "required": true,
      "check": {
        "type": "file_exists",
        "path": "docs/archive/delivery-plan-v0-baseline.md"
      }
    },
    {
      "id": "A2",
      "text": "Host smoke test runbook exists.",
      "required": true,
      "check": {
        "type": "file_exists",
        "path": "docs/host-smoke-test.md"
      }
    },
    {
      "id": "A3",
      "text": "Install, uninstall, and reinstall guide exists.",
      "required": true,
      "check": {
        "type": "file_exists",
        "path": "docs/install-operations.md"
      }
    },
    {
      "id": "A4",
      "text": "Release process and Claude distribution strategy are documented.",
      "required": true,
      "check": {
        "type": "file_exists",
        "path": "docs/release-process.md"
      }
    },
    {
      "id": "A5",
      "text": "Abnormal input tests exist for critical bad paths.",
      "required": true,
      "check": {
        "type": "file_exists",
        "path": "tests/error-cases.test.mjs"
      }
    },
    {
      "id": "A6",
      "text": "Remaining tasks clearly state that there is no longer any P0 blocking delivery.",
      "required": true,
      "check": {
        "type": "text_in_file",
        "path": "docs/remaining-tasks.md",
        "includes": "当前没有阻止交付的 P0"
      }
    },
    {
      "id": "A7",
      "text": "README links to architecture, development spec, and installation guide.",
      "required": true,
      "check": {
        "type": "text_in_file",
        "path": "README.md",
        "includes": "docs/install-operations.md"
      }
    }
  ],
  "verification": [
    {
      "id": "T1",
      "cmd": "npm test",
      "required": true
    },
    {
      "id": "T2",
      "cmd": "npm run review",
      "required": true
    },
    {
      "id": "T3",
      "cmd": "npm run doctor",
      "required": true
    },
    {
      "id": "T4",
      "cmd": "npm run bundle",
      "required": true
    }
  ],
  "metadata": {
    "milestone": "usable-baseline",
    "drafted_by": "codex",
    "deterministic_gate": true
  }
}
